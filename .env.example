# --- LOCAL DEVELOPMENT SETUP ---
# 1. Create a file named ".env" in the root of your project.
# 2. Copy the contents below into that ".env" file.
# 3. Replace the placeholder values with your actual API keys.

# GEMINI_API_KEY: Get this from https://aistudio.google.com/app/apikey
# In this project, it MUST be named exactly GEMINI_API_KEY (no VITE_ prefix)
GEMINI_API_KEY="your_actual_gemini_api_key_here"

# APP_URL: Only needed if you are testing features that require absolute URLs.
# Locally, this is usually:
APP_URL="http://localhost:3000"

# --- FIREBASE NOTE ---
# Your Firebase config is stored in 'firebase-applet-config.json'.
# This file is required for the app to start. Ensure it exists in your project root.
