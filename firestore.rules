rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    
    // Check if user is in 'admins' collection or has the owner email
    function isAdmin() { 
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'lebomofube1818@gmail.com'
      ); 
    }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // User Validation
    function isValidUser(data) {
      return data.uid == request.auth.uid
        && data.email is string && data.email.size() > 0
        && (!('isAdmin' in data) || data.isAdmin == false);
    }

    // User Profiles
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'sizeProfile', 'updatedAt']);
    }

    // Wishlist - Recursive access for owner
    match /wishlists/{ownerId}/{document=**} {
      allow read, write: if isSignedIn() && request.auth.uid == ownerId;
    }

    // Order Validation
    function isValidOrder(data) {
      return (
        (isSignedIn() && data.userId == request.auth.uid) ||
        (!isSignedIn() && data.userId == 'guest')
      )
        && data.items is list && data.items.size() > 0 && data.items.size() <= 50
        && data.total is number && data.total >= 0
        && data.status in ['pending', 'processed', 'shipped', 'delivered', 'completed']
        && data.createdAt == request.time;
    }

    match /orders/{orderId} {
      allow get: if (isSignedIn() && (existing().userId == request.auth.uid || isAdmin()));
      // For list, evaluate against resource.data to prevent scraping
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      
      allow create: if isValidOrder(incoming());
      
      allow update: if (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'estimatedArrival']))
                    || (isSignedIn() && existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['receivedConfirmation']));
      allow delete: if false;
    }

    match /admins/{adminId} {
      // Manageable via Admin SDK or Console only
      allow read: if isSignedIn() && request.auth.uid == adminId;
      allow write: if false;
    }

    match /test/{docId} {
      allow get: if true; // For testConnection()
    }
  }
}
